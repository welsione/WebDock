{
  "name": "webdock",
  "version": "2.0.1",
  "description": "把任意网页和本地服务变成原生桌面应用",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:mac": "electron-vite build && electron-builder --mac",
    "release:mac": "electron-vite build && bash scripts/build.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint electron/ src/ types/",
    "lint:fix": "eslint electron/ src/ types/ --fix",
    "format": "prettier --write electron/ src/ types/",
    "icons": "electron --user-data-dir=/tmp/webdock-icon-render scripts/render-app-icon.cjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0",
    "electron-log": "^5.4.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
